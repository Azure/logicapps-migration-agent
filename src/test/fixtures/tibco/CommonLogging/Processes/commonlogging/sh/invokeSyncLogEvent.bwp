        <bpws:variable messageType="ns1:syncLogEventResponse"
            name="Invoke" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:LogEventResponse" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable element="ns2:LogEventPub" name="Start"

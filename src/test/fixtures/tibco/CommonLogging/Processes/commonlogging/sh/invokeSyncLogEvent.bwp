    <bpws:partnerLinks>
        <bpws:partnerLink name="operations"
            partnerLinkType="ns0:partnerLinkType1" partnerRole="use"
            sca-bpel:ignore="true" sca-bpel:reference="operations" sca-bpel:wiredByImpl="false">
            <tibex:ReferenceBinding>
                <tibex:binding>
                    <bwbinding:BWBaseBinding
                        xmlns:axis2="http://xsd.tns.tibco.com/bw/models/binding/soap/axis2"
                        xmlns:bwbinding="http://tns.tibco.com/bw/model/core/bwbinding"
                        xmlns:pt="http://metcash.com.au/ESB/Services/LogService/Audit/Concrete/EventServices/v1"
                        xmlns:sca="http://www.osoa.org/xmlns/sca/1.0"
                        xmlns:scact="http://xsd.tns.tibco.com/amf/models/sca/componentType"
                        xmlns:scaext="http://xsd.tns.tibco.com/amf/models/sca/extensions"
                        xmlns:v1="http://metcash.com.au/ESB/Services/LogService/LogEvent/v1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                        <referenceBinding name="operations" xsi:type="scact:Reference">
                            <sca:interface.wsdl
                                interface="http://metcash.com.au/ESB/Services/LogService/Audit/Concrete/EventServices/v1#wsdl.interface(operations)" scaext:wsdlLocation="../../../Service%20Descriptors/Logging.wsdl"/>
                            <scaext:binding
                                locationURI="http://localhost:7562/LogService/InterfaceServices/SOAP/Event/EventServices.serviceagent/operationsEndpoint"
                                modelVersion="1.2.0"
                                name="SOAPReferenceBinding"
                                portName="operationsEndpoint"
                                portTypeQName="pt:operations"
                                portTypeWSDLLocation="platform:/resource/CommonLogging.sh/Service%20Descriptors/Logging.wsdl"
                                serviceBindingQName="pt:operationsEndpointBinding"
                                serviceQName="pt:EventServices"
                                transportBindingType="HTTP"
                                wsdlLocation="platform:/resource/CommonLogging.sh/Service%20Descriptors/Logging.wsdl" xsi:type="axis2:SOAPReferenceBinding">
                                <bindingType style="DOCUMENT"/>
                                <operationConfiguration
                                    action="/LogService/InterfaceServices/SOAP/Event/EventServices.serviceagent//logEvent" operationName="logEvent">
                                    <bindingType style="DOCUMENT"/>
                                    <messageConfiguration
                                    messageQName="pt:logEventRequest" wsdlLocation="platform:/resource/CommonLogging.sh/Service%20Descriptors/Logging.wsdl">
                                    <messagePartConfigurations
                                    encoding="literal"
                                    partElementName="v1:LogEventPub"
                                    partName="input" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <messageConfiguration
                                    action="fault1"
                                    messageDirection="FAULT"
                                    messageQName="pt:logEventFault" wsdlLocation="platform:/resource/CommonLogging.sh/Service%20Descriptors/Logging.wsdl">
                                    <messagePartConfigurations
                                    partElementName="v1:LogEventException"
                                    partName="details" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <context>
                                    <inputMapping/>
                                    <faultMappings direction="FAULT" faultName="fault1"/>
                                    </context>
                                </operationConfiguration>
                                <operationConfiguration
                                    action="/LogService/InterfaceServices/SOAP/Event/EventServices.serviceagent//syncLogEvent" operationName="syncLogEvent">
                                    <bindingType style="DOCUMENT"/>
                                    <messageConfiguration
                                    messageQName="pt:syncLogEventRequest" wsdlLocation="platform:/resource/CommonLogging.sh/Service%20Descriptors/Logging.wsdl">
                                    <messagePartConfigurations
                                    encoding="literal"
                                    partElementName="v1:LogEventPub"
                                    partName="input" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <messageConfiguration
                                    messageDirection="OUTPUT"
                                    messageQName="pt:syncLogEventResponse" wsdlLocation="platform:/resource/CommonLogging.sh/Service%20Descriptors/Logging.wsdl">
                                    <messagePartConfigurations
                                    encoding="literal"
                                    partElementName="v1:LogEventResponse"
                                    partName="output" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <messageConfiguration
                                    action="fault1"
                                    messageDirection="FAULT"
                                    messageQName="pt:syncLogEventFault" wsdlLocation="platform:/resource/CommonLogging.sh/Service%20Descriptors/Logging.wsdl">
                                    <messagePartConfigurations
                                    partElementName="v1:LogEventException"
                                    partName="details" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <context>
                                    <inputMapping/>
                                    <outputMapping direction="OUTPUT"/>
                                    <faultMappings direction="FAULT" faultName="fault1"/>
                                    </context>
                                </operationConfiguration>
                                <outboundConfiguration
                                    httpClient="commonlogging.sh.CLEHttpClientResource" xsi:type="axis2:HttpTransportConfiguration"/>
                            </scaext:binding>
                            <scact:bindingAdjunct bindingName="SOAPReferenceBinding">
                                <sca:property name="httpClient" scaext:simpleValue="CLEHttpClientResource"/>
                            </scact:bindingAdjunct>
                        </referenceBinding>
                    </bwbinding:BWBaseBinding>
                </tibex:binding>
            </tibex:ReferenceBinding>
        </bpws:partnerLink>
    </bpws:partnerLinks>

*.bak-session

# Artifacts generated by setup-grafana-portal.ps1 at runtime (contain
# environment-specific values such as kubeconfig paths, app names, contexts,
# and runtime-filled CONFIG incl. the Logic Apps master key). They are
# reproduced from the embedded templates in setup-grafana-portal.ps1 and must
# never be checked in.
openshift/grafana/grafana-portal/run-manager.js
openshift/grafana/grafana-portal/workflow-manager.js
openshift/grafana/grafana-portal/app-manager.js
openshift/grafana/grafana-portal/docker-compose.yaml
openshift/grafana/grafana-portal/provisioning/datasources/datasources.yaml
openshift/grafana/grafana-portal/provisioning/dashboards/default.yaml
openshift/grafana/grafana-portal/workflow-map.json
openshift/grafana/grafana-portal/dashboards/*.json
